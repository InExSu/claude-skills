root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4

[*.{md,markdown}]
# Два пробела в конце строки — это перенос строки в Markdown, их нельзя удалять.
# Two trailing spaces are a hard line break in Markdown and must be preserved.
trim_trailing_whitespace = false
